# Archivos de "siembra" del modpack FULL.
#
# Lo que se liste aqui se descarga SOLO si el jugador no lo tiene todavia:
# no se pisa nunca mas (aunque cambie el sha1) y no se borra aunque lo quites
# del manifest. Es para configuracion del jugador.
# Todo lo demas (mods, config/) sigue siendo gestionado: se pisa por sha1 y se
# borra al salir del manifest.
#
# Una ruta o glob por linea, relativa a la raiz del pack. '#' = comentario.
# Al cambiar de variante Full/Lite el launcher pregunta si re-aplicar estos.

options.txt
optionsof.txt
optionsshaders.txt

# Modo de rendimiento del juego (DbrCore, core.perf). Siembra preferencia=auto;
# despues lo escriben el jugador, el mod y el launcher. Ver
# DbrServerPack/docs/rendimiento/PLAN.md.
config/dbrcore/rendimiento.cfg

# Config de cliente que el jugador cambia desde el juego (menu V de JRMCore,
# HUDs, preferencias visuales). Gestionadas se revertian en cada Jugar.
config/jingames/jrmc/client_settings.cfg
config/jingames/jrmc/client_notifications.cfg
config/CustomNpcPlus/client.cfg
config/CustomNpcPlus/dbc/client.cfg
config/armourersWorkshop/client.cfg
config/ArmorStatusHUD.cfg
config/dbrcombathud.cfg
config/dbrvoice.cfg

# Ejemplo de .cfg que quieras dejar que el jugador toque sin que la sync se lo
# revierta (descomenta y ajusta):
# config/ArmorStatusHUD.cfg
# config/*Client*.cfg
